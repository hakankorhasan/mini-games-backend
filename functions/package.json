{
    "name": "mini-games-backend-functions",
    "version": "1.0.0",
    "description": "Cloud Functions for Mini-Games Backend",
    "scripts": {
        "build": "tsc",
        "build:watch": "tsc --watch",
        "serve": "npm run build && firebase emulators:start --only functions",
        "shell": "npm run build && firebase functions:shell",
        "start": "npm run shell",
        "deploy": "firebase deploy --only functions",
        "logs": "firebase functions:log",
        "test": "jest --forceExit"
    },
    "engines": {
        "node": "22"
    },
    "main": "lib/index.js",
    "dependencies": {
        "busboy": "^1.6.0",
        "firebase-admin": "^12.0.0",
        "firebase-functions": "^5.0.0",
        "jsonwebtoken": "^9.0.3",
        "node-forge": "^1.4.0"
    },
    "devDependencies": {
        "@types/busboy": "^1.5.4",
        "@types/jest": "^29.5.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node-forge": "^1.3.14",
        "jest": "^29.7.0",
        "ts-jest": "^29.1.0",
        "typescript": "^5.3.0"
    },
    "private": true
}
