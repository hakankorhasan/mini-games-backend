rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users: anyone can read profile, client can update safe fields only
    match /users/{userId} {
      allow read: if true;

      // Client can only update username and country
      // Rating, tier, seasonRating, gamesPlayed, correctAnswers, globalScore, weightedGlobalScore, streaks, premium are server-only
      allow update: if !request.resource.data.diff(resource.data).affectedKeys()
                        .hasAny(['rating', 'tier', 'seasonRating', 'gamesPlayed', 'correctAnswers',
                                 'globalScore', 'weightedGlobalScore', 'currentStreak', 'bestStreak',
                                 'premium']);

      // User docs are created by Cloud Functions (deviceId-based)
      allow create: if false;
      allow delete: if false;
    }

    // Purchase lookup: server-only (used for App Store notifications)
    match /purchaseLookup/{transactionId} {
      allow read, write: if false;
    }

    // Per-game stats: public read, Cloud Functions write
    match /users/{userId}/gameStats/{gameId} {
      allow read: if true;
      allow write: if false;
    }

    // Match results: no client access (anti-cheat log)
    match /matchResults/{docId} {
      allow read, write: if false;
    }

    // Seasons: public read, server-only write
    match /seasons/{seasonId} {
      allow read: if true;
      allow write: if false;
    }

    // Game Stories: all clients can read, only Admin SDK can write
    match /gameStories/{storyId} {
      allow read: if true;
      allow write: if false;
    }

    // Games: all clients can read the game list, only Admin SDK can write
    match /games/{gameId} {
      allow read: if true;
      allow write: if false;
    }

    // Number Circuit Daily: all clients can read, only Admin SDK can write
    match /numberCircuitDaily/{date} {
      allow read: if true;
      allow write: if false;
    }

    // Story Progress: device-id based, no auth required
    // Cloud Functions handle read/write; rules allow direct access too
    match /storyProgress/{deviceId}/stories/{storyId} {
      allow read, write: if true;
    }

    // Nonogram Levels: all clients can read, only Admin SDK can write
    match /nonogramLevels/{levelId} {
      allow read: if true;
      allow write: if false;
    }

    // Nonogram Progress: device-id based, no auth required
    match /nonogramProgress/{deviceId} {
      allow read, write: if true;
    }
    match /nonogramProgress/{deviceId}/levelStats/{statId} {
      allow read, write: if true;
    }
  }
}
